# === К.У.М. / KYM — root gitignore ===
# Unity + .NET + Docker + local secrets

# --- Secrets & local env ---
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
secrets/
**/secrets/
*.secret
credentials.json
appsettings.*.local.json
**/appsettings.Development.local.json

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db
$RECYCLE.BIN/

# --- Editors / IDE ---
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~

# --- Logs & temp ---
*.log
logs/
tmp/
temp/
.cache/

# --- .NET / C# ---
bin/
obj/
[Bb]uild/
[Bb]uilds/
artifacts/
TestResults/
*.user
*.userosscache
*.suo
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
project.lock.json
project.fragment.lock.json
artifacts/
PublishProfiles/
*.nupkg
*.snupkg
nuget.exe
.nuget/
packages/
!packages/build/
*.DotSettings.user

# --- Unity ---
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Cc]rashes/
*.pidb.meta
*.pdb.meta
*.mdb.meta
sysinfo.txt
*.stackdump
*.apk
*.aab
*.unitypackage
*.app
*.symbols.zip
InitTestScene*.unity*

# Unity Asset Store tools
Assets/AssetStoreTools*

# Autogenerated / crash reports
sysinfo.txt
crashlytics-build.properties

# Addressables / Burst / CSproj noise (regenerated)
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/StreamingAssets/aa*
.burst_cache/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
ExportedObj/
.consulo/

# Keep solution intentionally tracked if introduced at repo root later:
!/*.sln
!/src/**/*.sln

# --- Docker ---
docker-compose.override.yml
docker-compose.*.local.yml
.docker/
**/Dockerfile.local

# --- Node (tooling, if any) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# --- Coverage / test ---
coverage/
*.coverage
*.coveragexml
TestResults/

# --- Misc build outputs ---
dist/
out/
publish/
